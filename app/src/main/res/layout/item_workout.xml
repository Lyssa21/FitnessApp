<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/workoutCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:id="@+id/workoutIconTextView"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="🏃‍♀️"
            android:textSize="22sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/workoutNameTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Running"
                android:textColor="@color/dark_pink_text"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/workoutDetailsTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="30 min  •  220 kcal"
                android:textColor="@color/muted_pink_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/workoutLocationTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="No location"
                android:textColor="@color/muted_pink_text"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/workoutDateTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textColor="@color/muted_pink_text"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
