<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/cream_pink_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="28dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="250dp" android:background="@color/pastel_lilac" android:gravity="center" android:orientation="vertical" android:paddingTop="24dp">
   <TextView android:layout_width="96dp" android:layout_height="96dp" android:background="@drawable/profile_avatar" android:gravity="center" android:text="♡" android:textColor="@color/white" android:textSize="48sp" />
   <TextView android:id="@+id/profileNameTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/dark_pink_text" android:textSize="23sp" android:textStyle="bold" />
   <TextView android:id="@+id/profileEmailTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/muted_pink_text" android:textSize="13sp" />
  </LinearLayout>
  <TextView android:id="@+id/profileBackButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="12dp" android:text="‹  Back" android:textColor="@color/primary_pink" android:textSize="16sp" android:textStyle="bold" />
  <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_marginTop="12dp" android:layout_marginEnd="18dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="18dp" app:cardElevation="2dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="8dp">
    <TextView android:id="@+id/notificationsRow" style="@style/ProfileRow" android:text="♧   Notifications" />
   </LinearLayout>
  </androidx.cardview.widget.CardView>
  <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_marginTop="16dp" android:layout_marginEnd="18dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="18dp" app:cardElevation="2dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="8dp">
    <TextView android:id="@+id/securityRow" style="@style/ProfileRow" android:text="▣   Security" />
    <TextView android:id="@+id/themeRow" style="@style/ProfileRow" android:text="◉   Theme" />
   </LinearLayout>
  </androidx.cardview.widget.CardView>
  <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="18dp" android:layout_marginTop="16dp" android:layout_marginEnd="18dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="18dp" app:cardElevation="2dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingVertical="8dp">
    <TextView android:id="@+id/helpRow" style="@style/ProfileRow" android:text="♙   Help &amp; Support" />
    <TextView android:id="@+id/privacyRow" style="@style/ProfileRow" android:text="▢   Privacy policy" />
   </LinearLayout>
  </androidx.cardview.widget.CardView>
  <TextView android:id="@+id/notificationValueTextView" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
  <TextView android:id="@+id/themeValueTextView" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
 </LinearLayout>
</ScrollView>
