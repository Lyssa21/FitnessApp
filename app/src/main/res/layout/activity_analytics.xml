<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_pink_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="8dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/backButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="‹  BACK"
            android:textColor="@color/primary_pink"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Your progress,\nat a glance"
            android:textColor="@color/dark_pink_text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/periodSubtitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="A little progress adds up. Here's yours."
            android:textColor="@color/muted_pink_text"
            android:textSize="15sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="Time period"
            app:boxBackgroundColor="@color/white"
            app:boxBackgroundMode="filled"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp">

            <Spinner
                android:id="@+id/periodSpinner"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="Categories"
            android:textColor="@color/dark_pink_text" android:textSize="16sp" android:textStyle="bold" />
        <Spinner
            android:id="@+id/activitySpinner" android:layout_width="match_parent"
            android:layout_height="52dp" android:layout_marginTop="8dp"
            android:background="@drawable/profile_avatar" android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="24dp" app:cardElevation="3dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="22dp">
                <TextView android:id="@+id/selectedActivityTextView" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Running" android:textColor="@color/dark_pink_text"
                    android:textSize="28sp" android:textStyle="bold" />
                <TextView android:id="@+id/selectedActivitySubtitleTextView" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Your selected activity"
                    android:textColor="@color/muted_pink_text" android:textSize="14sp" />
                <TextView android:id="@+id/selectedActivityStatsTextView" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="22dp" android:lineSpacingExtra="8dp"
                    android:text="0 min\n0 kcal\n0.00 km\n0 steps" android:textColor="@color/dark_pink_text" android:textSize="19sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YOUR TOTALS"
                    android:textColor="@color/muted_pink_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/detailMetricsTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="5dp"
                    android:text="0 workouts     ·     0.0 km\n0.0 kg lifting volume     ·     0.0 km/h avg. speed"
                    android:textColor="@color/dark_pink_text"
                    android:textSize="15sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="@color/cream_pink_background" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/weeklyMinutesTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 min"
                            android:textColor="@color/primary_pink"
                            android:textSize="23sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active time"
                            android:textColor="@color/muted_pink_text"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/weeklyCaloriesTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 kcal"
                            android:textColor="@color/primary_pink"
                            android:textSize="23sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Calories"
                            android:textColor="@color/muted_pink_text"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/activeDaysTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 days"
                            android:textColor="@color/primary_pink"
                            android:textSize="23sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/activeDaysLabelTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active days"
                            android:textColor="@color/muted_pink_text"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Activity breakdown"
            android:textColor="@color/dark_pink_text"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Minutes by workout type"
            android:textColor="@color/muted_pink_text"
            android:textSize="14sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Running" android:textColor="@color/dark_pink_text" android:textSize="14sp" />
                <ProgressBar android:id="@+id/runningProgressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="6dp" android:max="150" android:progressTint="@color/primary_pink" />
                <TextView android:id="@+id/runningValueTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0 min" android:textColor="@color/muted_pink_text" android:textSize="13sp" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Walking" android:textColor="@color/dark_pink_text" android:textSize="14sp" />
                <ProgressBar android:id="@+id/walkingProgressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="6dp" android:max="150" android:progressTint="@color/pastel_blue" />
                <TextView android:id="@+id/walkingValueTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0 min" android:textColor="@color/muted_pink_text" android:textSize="13sp" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Cycling" android:textColor="@color/dark_pink_text" android:textSize="14sp" />
                <ProgressBar android:id="@+id/cyclingProgressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="6dp" android:max="150" android:progressTint="@color/soft_rose_pink" />
                <TextView android:id="@+id/cyclingValueTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0 min" android:textColor="@color/muted_pink_text" android:textSize="13sp" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Weightlifting" android:textColor="@color/dark_pink_text" android:textSize="14sp" />
                <ProgressBar android:id="@+id/weightliftingProgressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="6dp" android:max="150" android:progressTint="@color/muted_pink_text" />
                <TextView android:id="@+id/weightliftingValueTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0 min" android:textColor="@color/muted_pink_text" android:textSize="13sp" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Yoga" android:textColor="@color/dark_pink_text" android:textSize="14sp" />
                <ProgressBar android:id="@+id/yogaProgressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="6dp" android:max="150" android:progressTint="@color/pastel_blue" />
                <TextView android:id="@+id/yogaValueTextView" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="0 min" android:textColor="@color/muted_pink_text" android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/pastel_lilac"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A NOTE ON YOUR PROGRESS" android:textColor="@color/dark_pink_text" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.06" />
                <TextView android:id="@+id/insightTextView" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Your insight will appear here." android:textColor="@color/dark_pink_text" android:textSize="15sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
