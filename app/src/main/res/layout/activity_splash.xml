    android:gravity="center" android:orientation="vertical"
    android:background="@color/cream_pink_background">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="BlushFit" android:textColor="@color/primary_pink"
        android:textSize="38sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Your fitness, beautifully tracked"
        android:textColor="@color/muted_pink_text" />
</LinearLayout>
